page {
  min-height: 100vh;
  margin: 0;
  background: #f4f6f6;
  color: #0d2b45;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  letter-spacing: 0;
  overflow-x: hidden;
}
view, text, button, input, textarea { box-sizing: border-box; max-width: 100%; }
view, text { overflow-wrap: anywhere; word-break: break-word; }
button { margin: 0; padding: 0; background: transparent; font-size: 28rpx; line-height: 1.5; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 36rpx 32rpx 56rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.section { margin-top: 32rpx; }
.title { color: #0d2b45; font-size: 42rpx; font-weight: 600; line-height: 1.35; }
.subtitle { margin-top: 12rpx; color: #617586; font-size: 26rpx; line-height: 1.65; }
.panel { padding: 28rpx 0; border-top: 1rpx solid #dce5ea; }
.section-title { margin-bottom: 20rpx; color: #0d2b45; font-size: 31rpx; font-weight: 600; line-height: 1.4; }
.muted { color: #617586; font-size: 26rpx; line-height: 1.65; }
.optional { margin-left: 12rpx; color: #617586; font-size: 23rpx; font-weight: 400; }
.primary-btn, .ghost-btn, .danger-btn {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
  min-height: 88rpx; padding: 16rpx 20rpx; border-radius: 12rpx; font-weight: 600;
}
.primary-btn { color: #fff; background: #244d6d; }
.ghost-btn { color: #244d6d; background: #e8eff3; border: 1rpx solid #cbdbe5; }
.danger-btn { color: #9c4444; background: #f8eded; }
.primary-btn[disabled], .ghost-btn[disabled] { opacity: .55; }
button:active { opacity: .85; }
.btn-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-row button { flex: 1; min-width: 0; }
.field { margin-top: 30rpx; }
.field-label { margin-bottom: 16rpx; color: #314d63; font-size: 27rpx; font-weight: 600; }
.input, .textarea { width: 100%; border: 1rpx solid #d5e1e8; border-radius: 12rpx; background: #fff; color: #0d2b45; font-size: 28rpx; }
.input { height: 86rpx; padding: 0 22rpx; }
.textarea { height: 180rpx; min-height: 156rpx; padding: 20rpx 22rpx; line-height: 1.65; }
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { display: flex; align-items: center; justify-content: center; min-height: 70rpx; padding: 12rpx 22rpx; border: 1rpx solid #d5e1e8; border-radius: 10rpx; background: #fff; color: #526d81; font-size: 26rpx; line-height: 1.4; }
.chip.active { border-color: #5a7d9a; color: #0d2b45; background: #e5edf3; }
.tag { display: inline-flex; align-items: center; margin: 0 12rpx 12rpx 0; padding: 8rpx 14rpx; border-radius: 6rpx; background: #e8eff3; color: #425f74; font-size: 24rpx; }
.empty { padding: 80rpx 28rpx; text-align: center; color: #617586; }
.icon { display: inline-block; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; }
.error-text { color: #a43e3e; overflow-wrap: anywhere; }
