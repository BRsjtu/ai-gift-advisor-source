<view class="page">
  <view class="title">历史方案</view>
  <view class="subtitle">留住每一次用心挑选</view>

  <view wx:if="{{!history.length}}" class="empty">
    还没有保存方案
    <button class="primary-btn section" bindtap="start">开始选礼物</button>
  </view>

  <view class="section history-list">
    <view wx:for="{{history}}" wx:key="id" class="panel history-item" data-index="{{index}}" bindtap="openPlan">
      <view class="item-title">{{item.draft.relation || '收礼人'}} · {{item.draft.occasion || '送礼'}}</view>
      <view class="muted">{{item.profile.summary}}</view>
      <view wx:if="{{item.selectedCategory.name}}" class="muted">方向：{{item.selectedCategory.name}}</view>
      <view wx:if="{{item.products && item.products.length}}" class="muted">{{item.products.length}} 个商品候选</view>
      <view class="item-footer">{{item.savedAt}}</view>
    </view>
  </view>

  <button wx:if="{{history.length}}" class="danger-btn section" bindtap="clear">清空历史</button>
</view>
