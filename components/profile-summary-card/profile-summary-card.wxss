.profile-card { padding: 4rpx 0 32rpx; border-bottom: 1rpx solid #dce5ea; }
.label { color: #5a7d9a; font-size: 24rpx; font-weight: 600; letter-spacing: 0; }
.summary { margin-top: 14rpx; color: #0d2b45; font-size: 30rpx; font-weight: 600; line-height: 1.65; }
.meta-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28rpx 30rpx; margin-top: 28rpx; }
.meta-item { min-width: 0; }
.meta-label { margin-bottom: 10rpx; color: #5a7d9a; font-size: 24rpx; font-weight: 600; }
.point { display: flex; gap: 10rpx; margin-top: 7rpx; color: #314d63; font-size: 26rpx; line-height: 1.55; overflow-wrap: anywhere; }
.bullet { flex: 0 0 12rpx; color: #bf963e; }
