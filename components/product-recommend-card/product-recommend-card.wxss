.product-card { padding: 24rpx; border: 1rpx solid #dce5ea; border-radius: 16rpx; background: #fff; box-sizing: border-box; overflow: hidden; }
.product-main { display: flex; align-items: flex-start; gap: 24rpx; }
.cover { width: 200rpx; height: 200rpx; flex: 0 0 200rpx; border-radius: 12rpx; background: #f4f6f6; }
.fallback { display: flex; align-items: center; justify-content: center; color: #617586; font-size: 24rpx; }
.info { flex: 1; min-width: 0; }
.platform { color: #5a7d9a; font-size: 23rpx; }
.product-title { margin-top: 10rpx; color: #0d2b45; font-size: 28rpx; font-weight: 600; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
.price { margin-top: 14rpx; color: #8a651e; font-size: 32rpx; font-weight: 600; overflow-wrap: anywhere; }
.budget-status { margin-top: 10rpx; color: #72571e; font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.budget-within { color: #297164; }
.budget-unknown { color: #617586; }
.reason { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #e6edf1; color: #425f74; font-size: 25rpx; line-height: 1.65; }
.risk { margin-top: 12rpx; color: #617586; font-size: 23rpx; line-height: 1.6; }
.reason, .risk { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.expanded .product-title, .expanded .reason, .expanded .risk { display: block; -webkit-line-clamp: unset; }
